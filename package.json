{
  "name": "effect-sops",
  "version": "0.10.0",
  "description": "Effect-native SOPS Schema decoding and optional Alchemy resources with redacted secret outputs.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkmatter/effect-sops.git"
  },
  "homepage": "https://github.com/darkmatter/effect-sops#readme",
  "bugs": {
    "url": "https://github.com/darkmatter/effect-sops/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./Config": {
      "types": "./dist/Config.d.ts",
      "import": "./dist/Config.js",
      "default": "./dist/Config.js"
    },
    "./Schema": {
      "types": "./dist/Schema.d.ts",
      "import": "./dist/Schema.js",
      "default": "./dist/Schema.js"
    },
    "./cli": {
      "types": "./dist/sops-cli.d.ts",
      "import": "./dist/sops-cli.js",
      "default": "./dist/sops-cli.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "smoke:examples": "bun test examples/smoke.test.ts",
    "test": "cd test && bun test"
  },
  "dependencies": {
    "@drkmttr/sops-age": "^4.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.13",
    "@effect/platform-bun": "4.0.1",
    "@types/bun": "^1.3.2",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.1",
    "expect-type": "1.4.0",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "@distilled.cloud/cloudflare": "^1.0.0-rc.13",
    "alchemy": "2.0.0-beta.81",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@distilled.cloud/cloudflare": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "effect": {
      "optional": false
    }
  }
}